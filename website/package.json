{
  "name": "openvault-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro check && astro build && node scripts/og.mjs",
    "preview": "astro preview --host",
    "test": "vitest run",
    "check:links": "linkinator dist --recurse --skip \"^https?://(?!localhost|127\\.0\\.0\\.1)\" --verbosity error",
    "check:a11y": "node scripts/a11y.mjs",
    "check:lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@lhci/cli": "^0.14.0",
    "@resvg/resvg-js": "^2.6.2",
    "linkinator": "^6.1.0",
    "satori": "^0.60.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "puppeteer": "^9.1.1",
    "axe-core": "^4.14.0"
  }
}
