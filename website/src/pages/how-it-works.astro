---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import StatusBadge from '../components/StatusBadge.astro';
import PinnedFlow from '../components/PinnedFlow.astro';
import Buckets from '../components/art/Buckets.astro';
import Folder from '../components/art/Folder.astro';
import Parts from '../components/art/Parts.astro';
import Seal from '../components/art/Seal.astro';
import Clock from '../components/art/Clock.astro';
import Rewind from '../components/art/Rewind.astro';
import VaultDoor from '../components/art/VaultDoor.astro';
import { siteUrl } from '../config/site';
import { statusOf } from '../lib/registry';
import { breadcrumbs } from '../lib/jsonld';

const description = 'How OpenVault Backup is designed to work: connect storage, choose contents, resumable chunked backups, manifest.json, restore with undo and planned retention.';
const trail = [{ name: 'Home', path: '/' }, { name: 'How it works', path: '/how-it-works/' }];

const flow = [
  {
    title: 'Connect your storage',
    text: 'Add your own S3-compatible keys or choose a folder on your server today; your own Google Drive OAuth app is planned. The plugin talks to your storage directly, with no relay in between.',
    badges: [['Google Drive', 'destination-gdrive'], ['S3-compatible', 'destination-s3'], ['Local', 'destination-local']],
  },
  {
    title: 'Choose what and when',
    text: 'Pick the database, plugins, themes, uploads and more and back up by hand, choosing where the copy goes. Exclusions and schedules powered by Action Scheduler are planned.',
    badges: [['Manual', 'backup-manual'], ['Scheduled', 'backup-scheduled']],
  },
  {
    title: 'Run a resumable, chunked backup',
    text: 'The job works in small batches inside a time and memory budget, saves its place, and picks up again in the next run. No step needs a whole table or file list in memory.',
    badges: [['Backups', 'backup-manual']],
  },
  {
    title: 'Upload, with a manifest',
    text: 'Archives are saved in parts, with a manifest.json written next to every backup. The parts are then sent to each destination you chose, large ones in resumable pieces with retries; a failed destination ends the backup as partial and never stops the others. Rediscovering backups on a fresh install is planned.',
    badges: [['Parts and manifest', 'backup-manual'], ['S3-compatible upload', 'destination-s3'], ['Local folder copy', 'destination-local']],
  },
  {
    title: 'Apply retention',
    text: 'Keep the last N backups or the last X days, set per destination, with a lock to keep a backup forever. The lock exists today; automatic retention is planned.',
    badges: [['Lock', 'backup-manage'], ['Retention', 'backup-retention']],
  },
  {
    title: 'Restore with a safety snapshot',
    text: 'Restore a backup of this site from history: whole site, database only or files only. A safety snapshot is taken first and Undo brings it back. Pre-alpha: try it on a copy of your site first.',
    badges: [['Restore', 'restore-in-place']],
  },
] as const;
const arts = [Buckets, Folder, Parts, Seal, Clock, Rewind];
const plannedFrom = 4; // only the retention step (index 4) is still planned

const engine = [
  { label: 'Preflight', title: 'Preflight', text: 'Checks disk space, the temp directory and the destinations.', id: 'backup-manual' },
  { label: 'Database', title: 'Database export', text: 'Pure PHP by default, in batches; remembers the table and row position.', id: 'backup-manual' },
  { label: 'Files', title: 'File scan', text: 'Walks the directories and writes the list to a temp file; remembers its place.', id: 'backup-manual' },
  { label: 'Archive', title: 'Archive', text: 'Builds the archive in parts; remembers the file index and part number.', id: 'backup-manual' },
  { label: 'Upload', title: 'Upload', text: 'Sends each part to the destination, retrying up to three times per chunk.', id: 'destination-s3' },
  { label: 'Retention', title: 'Retention', text: 'Removes backups that fall outside your rules. Planned: nothing is removed automatically yet.', id: 'backup-retention' },
  { label: 'Cleanup', title: 'Cleanup', text: 'Deletes temporary files.', id: 'backup-manual' },
];

const restore = [
  'Preview the restore: sizes, disk space, warnings and what is never overwritten. Choose whole site, database only or files only, then type RESTORE.',
  'Download the parts to a temp directory and verify their SHA-256 checksums. Nothing on the site has changed yet.',
  'Confirm a second time with Apply restore now.',
  'Take a safety snapshot: a real, locked database backup. If it fails, the restore stops before anything changes.',
  'Check the database dump line by line against a strict whitelist, then switch on maintenance mode, with a 30 minute failsafe that expires on its own.',
  'Import the database in resumable slices. The plugin keeps its own settings, locks and active state.',
  'Extract files safely: no ../, no symlinks, never the plugin folder, its backup folder or wp-config.php. A rollback journal keeps every file that is overwritten.',
  'Switch maintenance off, flush caches and rewrite rules, and show a result page with Undo restore and Dismiss undo data.',
];
---

<Base title="How it works" description={description} path="/how-it-works/" jsonLd={[breadcrumbs(siteUrl(), trail)]}>
  <PageHead crumb="How it works" path="/how-it-works/" title="From your site to your storage, and back">
    <p>Six steps, each with its real status today.</p>
    <div slot="visual" aria-hidden="true"><VaultDoor /></div>
  </PageHead>

  <section class="section">
    <div class="container stack-lg">
      <div class="stack">
        <p class="eyebrow" data-reveal>Six steps</p>
        <h2 class="sec-title" data-reveal>The whole loop</h2>
      </div>
      <ol role="list" class="flow" data-reveal="stagger">
        {flow.map((s, i) => { const Art = arts[i]; return (
          <li class={`card flow-step ${i === plannedFrom ? "card--planned" : ""}`}>
            <div class={`art-wrap ${i === plannedFrom ? 'art--planned' : ''}`} aria-hidden="true"><Art /></div>
            <span class="mono num">{String(i + 1).padStart(2, "0")}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <ul role="list" class="f-badges">
              {s.badges.map(([name, id]) => (
                <li><span class="small muted">{name}</span> <StatusBadge status={statusOf(id)} /></li>
              ))}
            </ul>
          </li>
        ); })}
      </ol>
    </div>
  </section>

  <PinnedFlow id="engine" eyebrow="Inside a backup" heading="Small steps, never one long request" steps={engine} note="Shared hosts often stop PHP after 30 to 60 seconds and cap memory. Each run gets a time and memory budget; when it is used up the step saves a cursor and the next run continues. A lock stops two runs overlapping, and a stalled job is detected and resumed or marked failed." />

  <section class="section">
    <div class="container two">
      <div class="stack">
        <p class="eyebrow" data-reveal>Pre-alpha, in 0.3.0</p>
        <h2 class="sec-title" data-reveal>Inside a restore</h2>
        <p class="lede" data-reveal>A restore is a resumable job too, and it protects both your site and the plugin itself. Restore from history: <StatusBadge status={statusOf('restore-in-place')} /></p>
        <p class="muted" data-reveal>The plugin's own settings, locks and credentials survive the database import, its own folder is never overwritten, and the job record survives the database swap. Your admin session may end when the users table is replaced; progress then continues on a read-only status link.</p>
        <p class="small muted" data-reveal>Restore from an uploaded archive, migration to another domain or table prefix, and rediscovering backups on a fresh install via manifest.json are planned for a later phase. See the <a class="link" href="/roadmap/">roadmap</a> and the <a class="link" href="/restore-and-migrate/">restore and migrate page</a>.</p>
      </div>
      <ol class="restore" data-reveal="stagger">
        {restore.map((r) => <li data-spot>{r}</li>)}
      </ol>
    </div>
  </section>
</Base>

<style>
  .flow { padding: 0; display: grid; gap: var(--space-4); grid-template-columns: minmax(0, 1fr); }
  .flow-step { align-content: start; }
  .flow-step .num { color: var(--accent); }
  .flow-step :global(.art) { max-height: 8rem; }
  .f-badges { padding: 0; display: grid; gap: var(--space-2); justify-items: start; margin-top: var(--space-2); }
  .f-badges li { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }

  .two { display: grid; gap: var(--space-7); }
  .restore { padding: 0; list-style: none; counter-reset: rs; border-top: 1px solid var(--line-strong); align-self: start; }
  .restore li { counter-increment: rs; position: relative; padding: var(--space-4) 0 var(--space-4) 3.5rem; border-bottom: 1px solid var(--line); max-width: 58ch; }
  .restore li::after { content: counter(rs); position: absolute; left: 0; top: var(--space-3); font-family: var(--font-display); font-size: var(--step-3); line-height: 1.1; color: var(--accent); }

  @media (min-width: 48rem) { .flow { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .flow { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 60rem) {
    .two { grid-template-columns: 0.85fr 1.15fr; }
  }
</style>
