---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { repoUrl, siteUrl } from '../config/site';
import { breadcrumbs } from '../lib/jsonld';

const description = 'OpenVault Backup is GPLv2-or-later open source. Read the code, report bugs, test on your own host and help with the Docker test matrix.';
const trail = [{ name: 'Home', path: '/' }, { name: 'Open source', path: '/open-source/' }];

const ways = [
  { title: 'Report issues', text: 'Found a bug, an unclear message or a missing guide? Open an issue with your WordPress and PHP versions and what you expected.', cta: 'Open issues', href: `${repoUrl()}/issues` },
  { title: 'Send a pull request', text: 'Fixes and improvements are welcome. Read the plan files in docs/plan first, since they say what belongs to which phase, and keep changes small and reviewable.', cta: 'View the repository', href: repoUrl() },
  { title: 'Test on your own host', text: 'Real hosting is the hardest thing to simulate. Installing the build on a staging site and reporting what System Info shows helps a lot. Do not use it on a site you cannot afford to break.', cta: 'Download the build', href: '/download/' },
];

const axes = [
  ['PHP', '7.4, 8.0, 8.1, 8.2, 8.3, 8.4'],
  ['WordPress', '6.5 (minimum), 6.6, 6.7, 6.8, 6.9 and latest, with 6.4 as an informational profile that is known to fail'],
  ['Database', 'MySQL 5.7, 8.0, 8.4 and MariaDB 10.6, 10.11, 11.4'],
  ['Host profile', 'single site, multisite, restricted, low memory'],
];
---

<Base title="Open source" description={description} path="/open-source/" jsonLd={[breadcrumbs(siteUrl(), trail)]}>
  <PageHead crumb="Open source" path="/open-source/" title="Free software, in the open">
    <p>OpenVault Backup is released under the GPLv2 or later. You can read it, run it, change it and share it.</p>
  </PageHead>

  <section class="section">
    <div class="container stack-lg">
      <h2 class="sec-title">Licences</h2>
      <dl class="lic">
        <div>
          <dt>OpenVault Backup</dt>
          <dd>GPLv2 or later. Free to use, with no paid tiers and no locked features.</dd>
        </div>
        <div>
          <dt>Action Scheduler</dt>
          <dd>Bundled for background jobs, under the GPLv3. It is included unmodified and is updated by replacing the folder with a new release.</dd>
        </div>
      </dl>
      <p><a class="link" href={repoUrl()} rel="noopener">Browse the source on GitHub</a></p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container stack-lg">
      <h2 class="sec-title">How to help</h2>
      <ul role="list" class="ways">
        {ways.map((w) => (
          <li class="way">
            <h3>{w.title}</h3>
            <p class="muted">{w.text}</p>
            <a class="link" href={w.href} rel={w.href.startsWith('http') ? 'noopener' : undefined}>{w.cta}</a>
          </li>
        ))}
      </ul>
      <p class="muted">New here? The <a class="link" href={`${repoUrl()}/issues`} rel="noopener">issue tracker</a> is the place to find small tasks and to ask what is open for help.</p>
    </div>
  </section>

  <section class="section">
    <div class="container two">
      <div class="stack">
        <h2 class="sec-title">A Docker test matrix</h2>
        <p class="lede">The release zip, the same file users download, is installed into real WordPress sites across combinations of PHP, WordPress and database.</p>
        <p class="muted">You only need Docker. Add a row to a profile list to add an environment. It checks that the plugin installs and activates, creates its tables, runs a queued job through Action Scheduler, renders every admin page over real HTTP and logs no PHP warnings. It does not yet cover Nginx, a real shared host or large sites.</p>
      </div>
      <dl class="axes">
        {axes.map(([k, v]) => (
          <div><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .lic { display: grid; border-top: 1px solid var(--line-strong); }
  .lic div { display: grid; gap: var(--space-2) var(--space-6); padding-block: var(--space-5); border-bottom: 1px solid var(--line); }
  .lic dt { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.1; }
  .lic dd { margin: 0; color: var(--muted); max-width: 56ch; }

  .ways { padding: 0; display: grid; gap: var(--space-6); }
  .way { display: grid; gap: var(--space-3); align-content: start; justify-items: start; border-top: 1px solid var(--accent); padding-top: var(--space-5); }

  .two { display: grid; gap: var(--space-7); }
  .axes { display: grid; margin: 0; border-top: 1px solid var(--line-strong); align-self: start; }
  .axes div { display: grid; gap: var(--space-1) var(--space-5); padding-block: var(--space-4); border-bottom: 1px solid var(--line); }
  .axes dt { color: var(--accent); font-weight: 600; font-size: var(--step--1); }
  .axes dd { margin: 0; }

  @media (min-width: 48rem) {
    .lic div { grid-template-columns: 14rem minmax(0, 1fr); align-items: baseline; }
    .ways { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .axes div { grid-template-columns: 9rem minmax(0, 1fr); }
  }
  @media (min-width: 60rem) {
    .two { grid-template-columns: 1fr 1fr; }
  }
</style>
