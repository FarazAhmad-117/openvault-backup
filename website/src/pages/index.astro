---
import Base from '../layouts/Base.astro';
import DownloadButton from '../components/DownloadButton.astro';
import StatusBadge from '../components/StatusBadge.astro';
import SplitHeading from '../components/SplitHeading.astro';
import Icon from '../components/Icon.astro';
import HomeHero from '../components/home/HomeHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ProductTour from '../components/home/ProductTour.astro';
import RestoreBand from '../components/home/RestoreBand.astro';
import Bento from '../components/home/Bento.astro';
import HowTravels from '../components/home/HowTravels.astro';
import RoadmapStrip from '../components/home/RoadmapStrip.astro';
import Buckets from '../components/art/Buckets.astro';
import Folder from '../components/art/Folder.astro';
import Drive from '../components/art/Drive.astro';
import VaultDial from '../components/VaultDial.astro';
import { repoUrl } from '../config/site';
import { featuredFaqs } from '../data/faq';
import { providers } from '../data/providers';
import { statusOf } from '../lib/registry';
import { softwareApplication, faqPage } from '../lib/jsonld';

const description = 'Free, open-source WordPress backup plugin for S3-compatible storage or a folder. Pre-alpha: backup and restore with undo, no schedules or Drive yet.';
const faq = featuredFaqs;
---

<Base description={description} path="/" jsonLd={[softwareApplication(), faqPage(faq)]} announce>
  <HomeHero />

  <TrustStrip />

  <ProductTour />

  <Bento />

  <RestoreBand />

  <HowTravels />

  <section class="section dest" aria-labelledby="dest-h">
    <div class="container">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>Destinations</p>
        <SplitHeading id="dest-h" class="h-xl" lines={['Your server,', 'your bucket.']} />
      </div>
      <ul role="list" class="dests" data-reveal="stagger">
        <li>
          <article class="card">
            <div class="art-wrap" aria-hidden="true"><Buckets /></div>
            <h3>S3-compatible storage</h3>
            <p>Your own keys, any provider that speaks S3.</p>
            <ul role="list" class="pchips">
              {providers.map((p) => (<li><a class="pchip" href={`/s3-r2/${p.slug}/`} data-cursor="Read">{p.name}</a></li>))}
              <li><a class="pchip" href="/s3-r2/s3-compatible-setup/" data-cursor="Read">Custom endpoint</a></li>
            </ul>
            <p class="nuance mono">Verified live against one server (SeaweedFS). The others follow their documented endpoint patterns.</p>
            <StatusBadge status={statusOf('destination-s3')} />
          </article>
        </li>
        <li>
          <article class="card">
            <div class="art-wrap" aria-hidden="true"><Folder /></div>
            <h3>A folder on your server</h3>
            <p>Every backup lands in a protected folder first. Add another folder for a second copy.</p>
            <StatusBadge status={statusOf('destination-local')} />
            <a class="link" href="/how-it-works/" data-cursor="Read">How it works</a>
          </article>
        </li>
        <li>
          <article class="card card--planned">
            <div class="art-wrap art--planned" aria-hidden="true"><Drive /></div>
            <h3>Google Drive</h3>
            <p>Planned: your own OAuth app, drive.file scope only.</p>
            <StatusBadge status={statusOf('destination-gdrive')} />
            <a class="link" href="/google-drive/" data-cursor="Read">What is planned</a>
          </article>
        </li>
      </ul>
    </div>
  </section>

  <RoadmapStrip />

  <section class="section faq" aria-labelledby="faq-h">
    <div class="container faq-grid">
      <div class="stack">
        <p class="eyebrow" data-reveal>Straight answers</p>
        <SplitHeading id="faq-h" class="h-xl" lines={['Questions,', 'answered plainly.']} />
        <a class="link" href="/faq/" data-cursor="Read">Read the full FAQ</a>
      </div>
      <div class="qa" data-reveal="stagger">
        {faq.map((f) => (
          <details class="qa-item" data-accordion>
            <summary data-cursor="Open"><span>{f.q}</span><i aria-hidden="true"></i></summary>
            <p class="muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta band-ultra" data-scrub="pass" aria-labelledby="cta-h">
    <div class="container cta-grid">
      <div class="stack-lg">
        <p class="eyebrow" data-reveal>Try the pre-alpha</p>
        <SplitHeading id="cta-h" class="h-xl cta-h" lines={['Back up to a', 'bucket you own.']} />
        <p class="lede" data-reveal>Pre-alpha: try restore on a copy of your site first. Do not rely on it as your only backup.</p>
        <div class="cluster" data-reveal data-reveal-delay="100">
          <DownloadButton />
          <a class="btn btn--secondary" href={repoUrl()} rel="noopener" data-cursor="Read"><Icon name="code" size={18} /> Star on GitHub</a>
        </div>
      </div>
      <VaultDial class="cta-dial" />
    </div>
  </section>
</Base>

<style>
  .dests { padding: 0; display: grid; gap: var(--space-4); grid-template-columns: minmax(0, 1fr); }
  .dests > li { display: grid; }
  .dests .card { gap: var(--space-3); justify-items: start; }
  .dests .card p { max-width: 42ch; }
  .dests :global(.art) { max-height: 8.5rem; }
  .nuance { font-size: 0.6875rem; line-height: 1.6; text-transform: none; letter-spacing: 0.02em; color: var(--muted); }

  .faq .link { display: inline-block; margin-top: var(--space-5); }
  .faq-grid { display: grid; gap: var(--space-7); }
  .qa { display: grid; border-top: 1px solid var(--line-strong); }
  .qa-item { border-bottom: 1px solid var(--line-strong); }
  .qa-item summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); padding-block: var(--space-5); cursor: pointer; list-style: none; font-family: var(--font-display); font-size: var(--step-2); line-height: 1.15; }
  .qa-item summary::-webkit-details-marker { display: none; }
  .qa-item summary:hover { color: var(--accent); }
  .qa-item summary i { position: relative; flex: none; width: 1.25rem; height: 1.25rem; }
  .qa-item summary i::before, .qa-item summary i::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: currentColor; transition: transform 0.45s var(--ease-out); }
  .qa-item summary i::after { transform: rotate(90deg); }
  .qa-item[open] summary i::after { transform: rotate(0); }
  .qa-item p { padding-bottom: var(--space-5); max-width: 56ch; }

  .cta { position: relative; overflow: clip; --p: 0.5; }
  .cta-grid { display: grid; gap: var(--space-7); align-items: center; }
  .cta :global(.cta-h) { max-width: 12ch; }
  :global(.cta-dial) { width: min(100%, 26rem); height: auto; justify-self: center; overflow: visible; }
  :global(.cta-dial .ring) { fill: none; stroke: var(--line-strong); stroke-width: 0.8; }
  :global(.cta-dial .ticks) { fill: none; stroke: var(--accent); stroke-width: 1.4; stroke-linecap: round; }
  :global(.cta-dial .lock) { fill: none; stroke: var(--accent); stroke-width: 0.6; opacity: 0.4; }
  :global(.cta-dial .ptr) { fill: var(--accent); }
  :global(.cta-dial .spin) { transform-box: view-box; transform-origin: 50% 50%; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .cta { --p: 0; }
    :global(.cta-dial .spin) { transform: rotate(calc(var(--p) * 300deg)); }
    :global(html.js) .cta::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(36rem 28rem at 75% 50%, rgb(224 164 88 / 0.14), transparent 70%); opacity: calc(var(--p) * 1.6);
    }
  }

  @media (min-width: 48rem) { .dests { grid-template-columns: repeat(2, minmax(0, 1fr)); } .dests > li:first-child { grid-column: span 2; } }
  @media (min-width: 64rem) { .dests { grid-template-columns: 1.4fr 1fr 1fr; } .dests > li:first-child { grid-column: auto; } }
  @media (min-width: 60rem) {
    .faq-grid { grid-template-columns: 0.8fr 1.2fr; }
    .cta-grid { grid-template-columns: 1.2fr 0.8fr; }
  }
</style>
