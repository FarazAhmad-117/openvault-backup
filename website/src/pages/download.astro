---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { PLUGIN_VERSION, repoUrl, devDownloadUrl, siteUrl } from '../config/site';
import { howTo, breadcrumbs } from '../lib/jsonld';

const description = 'Download OpenVault Backup, a free GPLv2 WordPress plugin. Pre-alpha: local backups only, no restore yet. Requires WordPress 6.9+ and PHP 7.4+.';
const trail = [{ name: 'Home', path: '/' }, { name: 'Download', path: '/download/' }];

const checksumUrl = `${repoUrl()}/releases/latest/download/openvault-backup-${PLUGIN_VERSION}.zip.sha256`;
const releasesUrl = `${repoUrl()}/releases`;

const steps = [
  { name: 'Open Plugins', text: 'In your WordPress admin, go to Plugins, then Add New Plugin.' },
  { name: 'Choose Upload Plugin', text: 'Click Upload Plugin at the top of the page.' },
  { name: 'Choose the zip', text: 'Click Choose File and select the openvault-backup zip you downloaded.' },
  { name: 'Install', text: 'Click Install Now and wait for WordPress to unpack the plugin.' },
  { name: 'Activate', text: 'Click Activate Plugin. OpenVault Backup now appears in the admin menu.' },
];
---

<Base title="Download" description={description} path="/download/" jsonLd={[howTo('Install OpenVault Backup on WordPress', steps), breadcrumbs(siteUrl(), trail)]}>
  <PageHead crumb="Download" path="/download/" title="Download OpenVault Backup">
    <p>Free, open source and GPLv2 or later. Version {PLUGIN_VERSION}, an early build for people who want to follow along, test or contribute.</p>
  </PageHead>

  <section class="section">
    <div class="container stack-lg">
      <div class="warn-box" role="note">
        <h2>Pre-alpha: do not rely on it</h2>
        <p>This build can create local backups of your database and files and let you download them. It cannot restore a backup, run schedules or send backups to Google Drive or S3 yet, and backups stay on the same server, so they do not protect you if you lose it. Do not rely on it as your only backup, and do not delete any other backup because of it.</p>
      </div>

      <div class="get">
        <div class="stack">
          <DownloadButton />
        </div>
        <ul role="list" class="alt">
          <li><a class="link" href={checksumUrl} rel="noopener">SHA-256 checksum for {PLUGIN_VERSION}</a><span class="small muted">Compare it with the checksum of your downloaded zip.</span></li>
          <li><a class="link" href={devDownloadUrl()} rel="noopener">Development build</a><span class="small muted">Rebuilt from the main branch. Newest code, least tested.</span></li>
          <li><a class="link" href={releasesUrl} rel="noopener">All releases</a><span class="small muted">Every tagged version on GitHub. Release files appear there once a version is tagged.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container two">
      <div class="stack">
        <h2 class="sec-title">Requirements</h2>
        <dl class="reqs">
          <div><dt>WordPress</dt><dd>6.9 or newer</dd></div>
          <div><dt>PHP</dt><dd>7.4 or newer</dd></div>
          <div><dt>Cost</dt><dd>Free, with no paid tiers</dd></div>
        </dl>
        <p class="small muted">The WordPress minimum comes from the bundled Action Scheduler 4.2.0.</p>
      </div>
      <div class="stack-lg">
        <h2 class="sec-title">Install in five steps</h2>
        <ol role="list" class="steps">
          {steps.map((s, i) => (
            <li class="step">
              <span class="step-n" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{s.name}</h3>
                <p class="muted">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack">
      <h2 class="sec-title">What you will see after installing</h2>
      <p class="muted">The admin menu, a Back up now page (database and files, ZIP or TAR.GZ), a Backups page to download, lock or delete them, and a System Info page. Restore, schedules and off-site destinations are not built yet; a backup can only be downloaded and unpacked by hand. Follow progress on the <a class="link" href="/roadmap/">roadmap</a> or the <a class="link" href="/changelog/">changelog</a>.</p>
    </div>
  </section>
</Base>

<style>
  .get { display: grid; gap: var(--space-6); align-items: start; }
  .alt { padding: 0; display: grid; border-top: 1px solid var(--line-strong); }
  .alt li { display: grid; gap: var(--space-1); padding-block: var(--space-4); border-bottom: 1px solid var(--line); }
  .alt a { justify-self: start; font-weight: 600; }

  .two { display: grid; gap: var(--space-8); }
  .reqs { display: grid; margin: 0; border-top: 1px solid var(--line-strong); }
  .reqs div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-5); padding-block: var(--space-4); border-bottom: 1px solid var(--line); }
  .reqs dt { color: var(--muted); }
  .reqs dd { margin: 0; font-family: var(--font-display); font-size: var(--step-2); line-height: 1.1; }

  .steps { padding: 0; display: grid; }
  .step { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-5); border-top: 1px solid var(--line-strong); }
  .step:last-child { border-bottom: 1px solid var(--line-strong); }
  .step-n { font-family: var(--font-display); font-size: var(--step-3); line-height: 1; color: var(--accent); }
  .step h3 { font-size: var(--step-1); line-height: 1.25; }

  @media (min-width: 48rem) {
    .get { grid-template-columns: auto minmax(0, 1fr); gap: var(--space-8); }
  }
  @media (min-width: 60rem) {
    .two { grid-template-columns: 0.8fr 1.2fr; }
  }
</style>
