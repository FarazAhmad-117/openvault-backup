---
import Base from '../layouts/Base.astro';

const description = 'That page could not be found. Head back to the OpenVault Backup home page, features, download or docs.';
const links = [
  { href: '/', text: 'Home' },
  { href: '/features/', text: 'Features' },
  { href: '/download/', text: 'Download' },
  { href: '/docs/', text: 'Docs' },
];
---

<Base title="Page not found" description={description} path="/404/" noindex>
  <section class="section">
    <div class="container stack-lg">
      <p class="code" aria-hidden="true">404</p>
      <h1>This page is not in the vault.</h1>
      <p class="lede">The link may be old or mistyped. Try one of these instead.</p>
      <ul role="list" class="cluster">
        {links.map((l) => <li><a class="btn btn--secondary" href={l.href}>{l.text}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .code { font-family: var(--font-display); font-size: var(--step-5); color: var(--accent); line-height: 1; }
  h1 { font-size: var(--step-4); max-width: 18ch; }
  ul { padding: 0; }
</style>
