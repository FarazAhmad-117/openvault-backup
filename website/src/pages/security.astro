---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Icon from '../components/Icon.astro';
import ShieldLock from '../components/art/ShieldLock.astro';
import { repoUrl, siteUrl } from '../config/site';
import { statusOf } from '../lib/registry';
import { breadcrumbs } from '../lib/jsonld';

const description = 'How OpenVault Backup is designed to keep your data safe: your own credentials, encrypted secrets, authenticated downloads and an undoable restore.';
const icons = ["key", "scan", "lock", "download", "shield", "rewind", "lock", "eye-off", "file", "folder", "cloud"];
const trail = [{ name: 'Home', path: '/' }, { name: 'Security', path: '/security/' }];

interface Commitment { title: string; text: string; badges?: readonly (readonly [string, string])[] }

const commitments: Commitment[] = [
  {
    title: 'Your credentials, no relay servers',
    text: 'You connect your own S3 keys today, and your own Google OAuth app once Google Drive is built. Tokens and data travel only between your site and your storage. There is no shared OAuth app and no server of ours in the middle. For Google Drive, the OAuth state is designed to be validated and the redirect URI fixed to your admin URL.',
    badges: [['Google Drive', 'destination-gdrive'], ['S3-compatible', 'destination-s3']],
  },
  {
    title: 'Google Drive: drive.file scope only',
    text: 'The plugin asks for the narrowest Drive permission, which covers only files and folders it creates. It is not designed to read the rest of your Drive.',
    badges: [['Google Drive', 'destination-gdrive']],
  },
  {
    title: 'Credentials encrypted before storage',
    text: 'Saved credentials are encrypted at rest, with a key derived from your WordPress salts or an OVB_ENCRYPTION_KEY constant you set in wp-config. S3 secret keys are write-only: once saved they are never shown again in the interface or written to logs, and you can only replace them.',
  },
  {
    title: 'Downloads only through an authenticated controller',
    text: 'Backups are streamed to you by a download controller that checks who you are. There are no public download URLs.',
  },
  {
    title: 'Capability and nonce on every action',
    text: 'Every page, AJAX action and REST route requires the manage_options capability (network admin on multisite), and every form and REST call carries a nonce.',
  },
  {
    title: 'A safety snapshot before every restore',
    text: 'Before the database is replaced, a restore takes a real, locked database backup, and a rollback journal keeps every file it overwrites, so Undo can put both back. The plugin also protects itself: its own settings, locks and credentials survive a database import, and its own folder is never overwritten. Pre-alpha: try it on a copy first.',
    badges: [['Restore', 'restore-in-place']],
  },
  {
    title: 'The database dump is untrusted',
    text: 'A backup may sit in storage somebody else can write to, so every line of the dump is checked against a strict whitelist before anything reaches your database. A refused line stops the restore with its line number.',
    badges: [['Restore', 'restore-in-place']],
  },
  {
    title: 'Secrets stay out of the logs',
    text: 'Logs must never contain tokens or passwords. The logger redacts secrets, it has unit tests, and the test matrix checks that S3 secrets appear in no response, page or log.',
  },
  {
    title: 'Archives are extracted safely',
    text: 'During a restore, names with ../, absolute or backslash paths and symlinks are refused, and nothing is ever written over wp-config.php, server config files, the plugin folder or its backup folder. Restoring an uploaded archive is not built yet.',
    badges: [['Restore', 'restore-in-place'], ['Restore from upload', 'restore-upload']],
  },
  {
    title: 'Local backups are hidden',
    text: 'The local folder gets a random name, a deny rule and an index file, and sits outside the web root when possible. Nginx ignores .htaccess, so the plugin is designed to warn Nginx users.',
    badges: [['Local storage', 'destination-local']],
  },
  {
    title: 'Nothing leaves except where you point it',
    text: 'The plugin only contacts the destinations you configure. It has no analytics and does not phone home. S3 endpoints must use https, and link-local, metadata and other unsafe addresses are refused. Archives are not encrypted yet: they travel over HTTPS but are stored as they are, and archive encryption is planned.',
    badges: [['S3-compatible', 'destination-s3'], ['Encryption', 'encryption']],
  },
];
---

<Base title="Security" description={description} path="/security/" jsonLd={[breadcrumbs(siteUrl(), trail)]}>
  <PageHead crumb="Security" path="/security/" title="How it is designed to keep your data yours">
    <p>Design commitments, not an audit result. Each one shows the real status of the feature it protects.</p>
    <div slot="visual" aria-hidden="true"><ShieldLock /></div>
  </PageHead>

  <section class="section">
    <div class="container stack-lg">
      <div class="stack">
        <p class="eyebrow" data-reveal>{commitments.length} design rules</p>
        <h2 class="sec-title" data-reveal>How it is designed</h2>
      </div>
      <ul role="list" class="rules" data-reveal="stagger">
        {commitments.map((c, i) => (
          <li class="card rule">
            <span class="card-ico"><Icon name={icons[i]} size={22} /></span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <ul role="list" class="r-tags">
              {c.badges ? (
                c.badges.map(([name, id]) => (
                  <li><span class="small muted">{name}</span> <StatusBadge status={statusOf(id)} /></li>
                ))
              ) : (
                <li><span class="design-rule mono">Design rule</span></li>
              )}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container two">
      <div class="stack">
        <h2 class="sec-title" data-reveal>Report a vulnerability</h2>
        <p class="lede">Found something? Please tell us privately first, so it can be fixed before it is public.</p>
      </div>
      <div class="stack">
        <p class="muted">Use the repository's private security advisory form. Include what you found, how to reproduce it and which version you tested. Please do not open a public issue for a vulnerability.</p>
        <a class="btn btn--primary" href={`${repoUrl()}/security/advisories/new`} rel="noopener">Report a vulnerability</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .rules { padding: 0; display: grid; gap: var(--space-4); grid-template-columns: minmax(0, 1fr); }
  .rules > li { display: grid; }
  .rule h3 { font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.75rem); }
  .rule p { max-width: none; }
  .r-tags { padding: 0; display: grid; gap: var(--space-2); justify-items: start; margin-top: var(--space-2); }
  .r-tags li { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
  .design-rule { display: inline-flex; padding: 0.25em 0.9em; border: 1px dashed var(--line-strong); border-radius: 999px; color: var(--muted); white-space: nowrap; }
  .two { display: grid; gap: var(--space-7); }
  .two .btn { justify-self: start; }
  @media (min-width: 48rem) { .rules { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .rules { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 60rem) {
    .two { grid-template-columns: 0.9fr 1.1fr; }
  }
</style>
