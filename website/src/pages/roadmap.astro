---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import { PLUGIN_VERSION, siteUrl } from '../config/site';
import { milestones } from '../data/roadmap';
import { breadcrumbs } from '../lib/jsonld';

const description = 'The OpenVault Backup roadmap: Alpha, Beta and 1.0 milestones with their exit criteria, plus every feature by phase. No dates, no promises.';
const trail = [{ name: 'Home', path: '/' }, { name: 'Roadmap', path: '/roadmap/' }];
---

<Base title="Roadmap" description={description} path="/roadmap/" jsonLd={[breadcrumbs(siteUrl(), trail)]}>
  <PageHead crumb="Roadmap" path="/roadmap/" title="Three milestones, no dates">
    <p>Each milestone is finished when its exit criteria are met, not when a date arrives. We do not publish dates we cannot keep.</p>
  </PageHead>

  <section class="section">
    <div class="container stack-lg">
      <h2 class="sec-title">Release milestones</h2>
      <ol role="list" class="timeline">
        <li class="node node--now">
          <span class="marker" aria-hidden="true"></span>
          <div class="body">
            <p class="kicker small">Where we are</p>
            <h3>Pre-alpha {PLUGIN_VERSION}</h3>
            <p class="muted">The foundation is built: plugin structure, database tables, admin shell and System Info. The plugin cannot back up or restore sites yet.</p>
          </div>
        </li>
        {milestones.map((m) => (
          <li class="node">
            <span class="marker" aria-hidden="true"></span>
            <div class="body">
              <p class="kicker small">Milestone, published on {m.channel}</p>
              <h3>{m.name}</h3>
              <p class="muted">{m.summary}</p>
              <p class="exit-label small">Exit criteria</p>
              <ul class="exit">
                {m.exit.map((e) => <li>{e}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container stack-lg">
      <div class="stack">
        <h2 class="sec-title">Features by phase</h2>
        <p class="lede">The phases group the work. The milestones above say when the work counts as done.</p>
      </div>
      <FeatureGrid headingLevel="h3" />
    </div>
  </section>
</Base>

<style>
  .timeline { padding: 0; position: relative; display: grid; gap: var(--space-7); margin-top: var(--space-6); }
  .timeline::before { content: ''; position: absolute; left: 0.5rem; top: 0.6rem; bottom: 0.6rem; width: 1px; background: var(--line-strong); }
  .node { position: relative; padding-left: var(--space-7); }
  .marker { position: absolute; left: 0; top: 0.35rem; width: 1.05rem; height: 1.05rem; border-radius: 50%; background: var(--bg); border: 1px solid var(--accent); }
  .node--now .marker { background: var(--warn); border-color: var(--warn); box-shadow: 0 0 0 4px color-mix(in srgb, var(--warn) 22%, transparent); }
  .body { display: grid; gap: var(--space-2); justify-items: start; }
  .kicker { color: var(--accent); font-weight: 600; letter-spacing: 0.02em; }
  .node--now .kicker { color: var(--warn); }
  .body h3 { font-size: var(--step-3); }
  .exit-label { margin-top: var(--space-3); color: var(--muted); font-weight: 600; }
  .exit { padding: 0; list-style: none; display: grid; gap: var(--space-1); }
  .exit li { padding-left: 1.2em; position: relative; }
  .exit li::before { content: ''; position: absolute; left: 0; top: 0.8em; width: 0.6em; height: 1px; background: var(--accent); }
  @media (min-width: 56rem) {
    .timeline { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); }
    .timeline::before { left: 0; right: 0; top: 0.85rem; bottom: auto; width: auto; height: 1px; }
    .node { padding-left: 0; padding-top: var(--space-6); }
    .marker { top: 0.35rem; }
  }
</style>
