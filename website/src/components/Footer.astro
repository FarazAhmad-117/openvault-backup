---
import { SITE_NAME, PLUGIN_VERSION, repoUrl } from '../config/site';

const preAlpha = PLUGIN_VERSION.startsWith('0.');
const columns = [
  { title: 'Product', links: [
    { text: 'Features', href: '/features/' },
    { text: 'How it works', href: '/how-it-works/' },
    { text: 'Roadmap', href: '/roadmap/' },
    { text: 'Changelog', href: '/changelog/' },
  ] },
  { title: 'Learn', links: [
    { text: 'Google Drive', href: '/google-drive/' },
    { text: 'S3-compatible', href: '/s3-r2/' },
    { text: 'Compare', href: '/compare/' },
    { text: 'Docs', href: '/docs/' },
    { text: 'FAQ', href: '/faq/' },
  ] },
  { title: 'Project', links: [
    { text: 'Download', href: '/download/' },
    { text: 'Security', href: '/security/' },
    { text: 'Open source', href: '/open-source/' },
    { text: 'GitHub', href: repoUrl() },
  ] },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div class="about">
        <p class="name">{SITE_NAME}</p>
        {preAlpha && <p class="muted small honest">OpenVault Backup is pre-alpha software. It can back up to your server, S3-compatible storage or a folder and restore a backup of this site with undo, but it cannot schedule backups or send them to Google Drive yet. Try restore on a copy of your site first.</p>}
      </div>
      {columns.map((c) => (
        <nav aria-label={c.title}>
          <h2 class="col-title">{c.title}</h2>
          <ul role="list">
            {c.links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>
    <div class="legal small muted">
      <p>GPLv2 or later</p>
      <p>Not affiliated with WordPress or the WordPress Foundation.</p>
      <a class="top mono u-draw" href="#top" data-top data-cursor="Top">Back to top <span class="arrow" aria-hidden="true">&uarr;</span></a>
    </div>
  </div>
  <p class="wordmark" aria-hidden="true" data-spot data-reveal="lines"><span class="ln"><span class="ln-i" style="--i:0">OpenVault</span></span></p>
</footer>

<style>
  .site-footer { margin-top: var(--space-9); background: var(--surface); border-top: 1px solid var(--line); padding-block: var(--space-8) var(--space-6); }
  .cols { display: grid; gap: var(--space-7) var(--space-6); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .about { grid-column: 1 / -1; }
  .name { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.1; margin-bottom: var(--space-3); }
  .honest { max-width: 34ch; }
  .col-title { font-family: var(--font-body); font-size: var(--step--1); font-weight: 600; letter-spacing: 0.02em; color: var(--muted); margin-bottom: var(--space-3); }
  ul { padding: 0; display: grid; gap: var(--space-2); }
  nav a { text-decoration: none; font-size: var(--step--1); display: inline-block; padding-block: 0.2rem; }
  nav a:hover { color: var(--accent); }
  .legal { margin-top: var(--space-8); padding-top: var(--space-5); border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }
  .legal p { max-width: none; }
  .top { margin-left: auto; color: var(--text); display: inline-flex; gap: 0.6em; align-items: center; min-height: 2.75rem; }
  .arrow { display: inline-block; transition: transform 0.5s var(--ease-out); }
  .top:hover .arrow, .top:focus-visible .arrow { transform: translateY(-0.35em); }
  .site-footer { position: relative; overflow: clip; padding-bottom: 0; }
  .wordmark {
    --mx: 50%; position: relative; isolation: isolate; max-width: none; margin: var(--space-6) 0 0; text-align: center; user-select: none;
    font-family: var(--font-display); font-size: clamp(4.5rem, 21.5vw, 24rem); line-height: 0.82; letter-spacing: -0.03em;
    color: var(--line-strong); /* solid colour, always visible; decorative (aria-hidden) */
    transform: translateY(12%);
  }
  /* pointer spotlight = a separate glow layer over the word (blend), never the text fill */
  .wordmark::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: 0; mix-blend-mode: screen; transition: opacity 0.4s;
    background: radial-gradient(18rem circle at var(--mx) 55%, rgb(224 164 88 / 0.6), transparent 100%);
  }
  @media (hover: hover) { .wordmark:hover::after { opacity: 1; } }
  .wordmark :global(.ln) { padding-bottom: 0.2em; margin-bottom: -0.2em; }
  @media (min-width: 48rem) {
    .cols { grid-template-columns: 1.4fr repeat(3, 1fr); }
    .about { grid-column: auto; }
  }
</style>
