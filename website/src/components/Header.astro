---
import { SITE_NAME, PLUGIN_VERSION } from '../config/site';

interface Props { current?: string }
const { current = '' } = Astro.props;

const nav = [
  { href: '/features/', text: 'Features' },
  { href: '/google-drive/', text: 'Google Drive' },
  { href: '/s3-r2/', text: 'S3 & R2' },
  { href: '/compare/', text: 'Compare' },
  { href: '/docs/', text: 'Docs' },
];
const isCurrent = (href: string) => current !== '' && (current === href || current.startsWith(href));
const preAlpha = PLUGIN_VERSION.startsWith('0.');
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${SITE_NAME} home`} aria-current={current === '/' ? 'page' : undefined}>
      <svg class="mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
        <circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="1.5" />
        <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M16 3.8v2.6M16 25.6v2.6M3.8 16h2.6M25.6 16h2.6" />
        </g>
        <circle cx="16" cy="16" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M16 16l4.6-4.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        <circle cx="16" cy="16" r="1.4" fill="currentColor" />
      </svg>
      <span class="word">OpenVault</span>
    </a>

    {preAlpha && <span class="pill">Pre-alpha</span>}

    <nav class="nav-desktop" aria-label="Primary">
      <ul role="list">
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.text}</a></li>
        ))}
      </ul>
      <a class="btn btn--primary btn--sm" href="/download/" aria-current={isCurrent('/download/') ? 'page' : undefined}>Download</a>
    </nav>

    <details class="nav-mobile">
      <summary>
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <path class="bars" d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" />
        </svg>
      </summary>
      <nav class="sheet" aria-label="Primary mobile">
        <ul role="list">
          {nav.map((n) => (
            <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.text}</a></li>
          ))}
        </ul>
        <a class="btn btn--primary" href="/download/">Download</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgb(7 8 10 / 0.92); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: var(--space-4); min-height: 4rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--accent); text-decoration: none; }
  .brand:hover { color: var(--accent-hover); }
  .word { font-family: var(--font-display); font-size: 1.65rem; line-height: 1; color: var(--text); letter-spacing: -0.01em; }
  .pill {
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.02em; color: var(--warn);
    border: 1px solid color-mix(in srgb, var(--warn) 45%, var(--line)); border-radius: 999px;
    padding: 0.1rem 0.6rem; white-space: nowrap;
  }
  .nav-desktop { margin-left: auto; display: none; align-items: center; gap: var(--space-6); }
  .nav-desktop ul { display: flex; gap: var(--space-5); padding: 0; }
  .nav-desktop li a { text-decoration: none; color: var(--muted); font-size: var(--step--1); font-weight: 500; padding-block: 0.4rem; border-bottom: 1px solid transparent; }
  .nav-desktop li a:hover { color: var(--text); }
  a[aria-current='page']:not(.btn) { color: var(--text); }
  .nav-desktop li a[aria-current='page'] { border-bottom-color: var(--accent); }

  .nav-mobile { margin-left: auto; }
  .nav-mobile summary {
    list-style: none; cursor: pointer; display: grid; place-items: center;
    width: 2.75rem; height: 2.75rem; border: 1px solid var(--muted); border-radius: 999px; color: var(--text);
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile summary:hover { border-color: var(--accent); color: var(--accent); }
  .nav-mobile[open] summary { border-color: var(--accent); color: var(--accent); }
  .sheet {
    position: absolute; left: 0; right: 0; top: 100%; background: var(--surface);
    border-bottom: 1px solid var(--line); padding: var(--space-4) var(--gutter) var(--space-6);
    display: grid; gap: var(--space-4); box-shadow: 0 24px 40px -16px rgb(0 0 0 / 0.8);
  }
  .sheet ul { padding: 0; display: grid; }
  .sheet li a { display: block; padding: 0.85rem 0; border-bottom: 1px solid var(--line); text-decoration: none; font-size: var(--step-1); font-family: var(--font-display); }
  .sheet .btn { justify-self: stretch; }

  @media (min-width: 56rem) {
    .nav-desktop { display: flex; }
    .nav-mobile { display: none; }
  }
  @media (max-width: 22rem) {
    .pill { display: none; }
  }
</style>
