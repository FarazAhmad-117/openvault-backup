---
// Real facts only. The environment count comes from tests/matrix/profiles.tsv (12 gating profiles plus 1 informational one).
import Icon from './Icon.astro';
const facts = [
  { icon: 'scale', k: 'GPLv2 or later', v: 'Free and open source' },
  { icon: 'server', k: 'No relay servers', v: 'Your site talks to your storage' },
  { icon: 'key', k: 'Your own keys', v: 'Encrypted in your database' },
  { icon: 'box', k: '12 test environments', v: 'PHP 7.4 to 8.4, WordPress 6.5+' },
];
---

<section class="trust" aria-label="Facts">
  <ul role="list" class="container" data-reveal="stagger">
    {facts.map((f) => (
      <li><Icon name={f.icon} size={22} /><div><strong>{f.k}</strong><span>{f.v}</span></div></li>
    ))}
  </ul>
</section>

<style>
  .trust { border-block: 1px solid var(--line); background: var(--surface); }
  ul { padding-block: var(--space-5); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) var(--space-4); }
  li { display: flex; align-items: flex-start; gap: var(--space-3); }
  li :global(.icon) { color: var(--accent); flex: none; margin-top: 0.1rem; }
  strong { display: block; font-weight: 600; font-size: var(--step--1); color: var(--text); }
  span { display: block; font-size: 0.8125rem; color: var(--muted); line-height: 1.4; }
  @media (min-width: 56rem) { ul { grid-template-columns: repeat(4, minmax(0, 1fr)); } li + li { border-left: 1px solid var(--line); padding-left: var(--space-5); } }
</style>
