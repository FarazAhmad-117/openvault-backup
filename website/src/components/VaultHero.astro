---
// Decorative vault door. Static (closed) by default. Inside a [data-scrub] track the dial, handle, bolts and the
// swing-away are driven by the --p custom property (see the style block); nothing moves without JS or with reduced motion.
const C = 200;
const polar = (r: number, deg: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [C + r * Math.cos(a), C + r * Math.sin(a)] as const;
};
const ticks = Array.from({ length: 60 }, (_, i) => {
  const major = i % 5 === 0;
  const [x1, y1] = polar(major ? 98 : 103, i * 6);
  const [x2, y2] = polar(112, i * 6);
  return { major, d: `M${x1.toFixed(2)} ${y1.toFixed(2)}L${x2.toFixed(2)} ${y2.toFixed(2)}` };
});
const minor = ticks.filter((t) => !t.major).map((t) => t.d).join('');
const major = ticks.filter((t) => t.major).map((t) => t.d).join('');
const bolts = Array.from({ length: 8 }, (_, i) => i * 45);
const heads = Array.from({ length: 16 }, (_, i) => polar(172, i * 22.5 + 11.25));
const spokes = [0, 120, 240];
---

<div class="vault">
  <svg viewBox="0 0 400 400" role="img" aria-label="Illustration of a vault door with a combination dial and locking bolts" focusable="false">
    <circle class="frame" cx="200" cy="200" r="192" />
    <circle class="frame-inner" cx="200" cy="200" r="158" />
    {heads.map(([x, y]) => <circle class="head" cx={x.toFixed(2)} cy={y.toFixed(2)} r="3.2" />)}

    {bolts.map((a) => (
      <g transform={`rotate(${a} 200 200)`}>
        <rect class="bolt" x="190" y="22" width="20" height="44" rx="3" />
      </g>
    ))}

    <circle class="face" cx="200" cy="200" r="150" />
    <circle class="face-line" cx="200" cy="200" r="140" />
    <circle class="glow" cx="200" cy="200" r="86" />

    <g class="dial">
      <circle class="ring" cx="200" cy="200" r="116" />
      <path class="tick" d={minor} />
      <path class="tick tick--major" d={major} />
      <circle class="ring" cx="200" cy="200" r="92" />
    </g>
    <path class="pointer" d="M200 76l7 -13h-14z" />

    <g class="handle">
      <circle class="hub-ring" cx="200" cy="200" r="64" />
      {spokes.map((a) => (
        <g transform={`rotate(${a} 200 200)`}>
          <path class="spoke" d="M200 200V142" />
          <circle class="knob" cx="200" cy="134" r="9" />
        </g>
      ))}
      <circle class="hub" cx="200" cy="200" r="20" />
      <circle class="hub-dot" cx="200" cy="200" r="5" />
    </g>
  </svg>
</div>

<style>
  .vault { width: 100%; aspect-ratio: 1 / 1; margin-inline: auto; }
  svg { width: 100%; height: 100%; overflow: visible; }
  .frame { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.5; }
  .frame-inner { fill: var(--bg); stroke: var(--line); stroke-width: 1; }
  .head { fill: var(--line-strong); }
  .bolt { fill: var(--surface-2); stroke: var(--accent); stroke-width: 1.5; }
  .face { fill: var(--surface-2); stroke: var(--accent); stroke-width: 2; }
  .face-line { fill: none; stroke: var(--line-strong); stroke-width: 1; }
  .glow { fill: color-mix(in srgb, var(--accent) 22%, transparent); opacity: 0.35; }
  .ring { fill: none; stroke: var(--accent); stroke-width: 1.25; }
  .tick { fill: none; stroke: var(--muted); stroke-width: 1.25; stroke-linecap: round; }
  .tick--major { stroke: var(--accent); stroke-width: 2.25; }
  .pointer { fill: var(--accent); }
  .hub-ring { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1; }
  .spoke { stroke: var(--accent); stroke-width: 6; stroke-linecap: round; fill: none; }
  .knob { fill: var(--surface-2); stroke: var(--accent); stroke-width: 2.5; }
  .hub { fill: var(--accent); }
  .hub-dot { fill: var(--accent-ink); }

  .dial, .handle { transform-box: view-box; transform-origin: 50% 50%; }

  /* Scroll-driven by --p (0..1, set on the pinned hero track by src/motion/scrub.ts; stays 0 without JS or with reduced motion).
     Stage a: dial turns (0-0.5). Stage b: handle turns and bolts retract (0.3-0.55). Stage c: the door swings away (0.55-0.95). */
  .vault {
    --a: clamp(0, calc(var(--p, 0) / 0.5), 1);
    --b: clamp(0, calc((var(--p, 0) - 0.3) / 0.25), 1);
    --c: clamp(0, calc((var(--p, 0) - 0.55) / 0.4), 1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .vault { transform: scale(calc(1 + var(--c) * 2.4)); opacity: calc(1 - var(--c) * 1.25); will-change: transform, opacity; }
    .dial { transform: rotate(calc(var(--a) * 360deg)); }
    .handle { transform: rotate(calc(var(--b) * -120deg)); }
    .bolt { transform: translateY(calc(var(--b) * 40px)); }
    .glow { opacity: calc(0.35 + var(--b) * 0.65); }
  }
</style>
