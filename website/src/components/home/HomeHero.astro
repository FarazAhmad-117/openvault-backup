---
// Home hero: pinned scroll scene. The REAL plugin screen floats beside the headline; as you scroll the vault dial turns behind it,
// the copy steps aside and the screen comes forward. --p comes from src/motion/scrub.ts.
// Without JS or with reduced motion nothing is pinned and everything is simply stacked and visible.
import DownloadButton from '../DownloadButton.astro';
import SplitHeading from '../SplitHeading.astro';
import StatusBadge from '../StatusBadge.astro';
import VaultHero from '../VaultHero.astro';
import ProductFrame from '../ProductFrame.astro';
import { shots } from '../../data/product';
import { TAGLINE, PLUGIN_VERSION, repoUrl } from '../../config/site';
---

<section class="hero-track" data-scrub="track" data-stages="2">
  <div class="hero-stage">
    <div class="glow" aria-hidden="true"></div>
    <div class="door" aria-hidden="true"><VaultHero /></div>

    <div class="container top" data-reveal-now="fade" style="--i:0">
      <span class="eyebrow">Open-source WordPress backup</span>
      <span class="mono ver">v{PLUGIN_VERSION}</span>
    </div>

    <div class="container hero-grid">
      <div class="copy">
        <SplitHeading as="h1" now class="h1" lines={['WordPress backups,', 'in a vault only you', 'hold the key to.']} />
        <p class="lede" data-reveal-now="fade" style="--i:4">{TAGLINE}</p>
        <div class="cluster" data-reveal-now="fade" style="--i:5">
          <DownloadButton />
          <a class="btn btn--secondary" href={repoUrl()} rel="noopener" data-cursor="Read">Star on GitHub</a>
        </div>
      </div>
      <div class="hero-frame" data-reveal-now="fade" style="--i:3">
        <ProductFrame {...shots.done} eager sizes="(min-width: 60rem) 52vw, 92vw" widths={[480, 800, 1200, 1600]} caption="Backup complete, with download links" />
      </div>
    </div>

    <aside class="status" aria-label="Project status" data-reveal-now="fade" style="--i:7">
      <div class="container status-in">
        <StatusBadge status="in-progress" />
        <p><span class="k">Pre-alpha {PLUGIN_VERSION}.</span> Backup and restore work. Schedules and Google Drive are not built yet.</p>
        <a class="link" href="/roadmap/">See the roadmap</a>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero-track { position: relative; --p: 0; margin-top: -4rem; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-track { height: 230svh; }
  }
  .hero-stage {
    position: sticky; top: 0; min-height: 100svh; overflow: hidden;
    display: grid; grid-template-rows: 1fr auto; isolation: isolate;
  }
  .hero-stage::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image: linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: calc(100% / 6) 100%;
    -webkit-mask-image: linear-gradient(180deg, #000, transparent 85%); mask-image: linear-gradient(180deg, #000, transparent 85%); opacity: 0.5;
  }
  .glow {
    position: absolute; inset: -10%; z-index: -1; pointer-events: none;
    background: radial-gradient(40rem 34rem at 76% 48%, rgb(224 164 88 / 0.18), transparent 70%), radial-gradient(60rem 30rem at 0% 100%, rgb(224 164 88 / 0.06), transparent 70%);
  }
  .door { position: absolute; z-index: -1; right: -12vw; top: 50%; width: min(90vw, 44rem); translate: 0 -50%; opacity: 0.22; }
  .top { position: absolute; left: 0; right: 0; top: 5.25rem; display: flex; justify-content: space-between; gap: var(--space-4); }
  .ver { color: var(--muted); }
  .hero-grid { display: grid; gap: var(--space-5); align-content: center; padding-top: 7.5rem; padding-bottom: var(--space-6); }
  .hero-frame { order: -1; width: min(100%, 26rem); justify-self: center; }
  .hero-frame :global(.pframe-cap) { display: none; }
  .copy { display: grid; gap: var(--space-4); justify-items: start; }
  .copy :global(.h1) { font-size: clamp(2.375rem, 0.8rem + 7.4vw, 8rem); line-height: 0.95; letter-spacing: -0.035em; max-width: none; text-wrap: initial; }
  .copy .lede { max-width: 38ch; font-size: var(--step-0); }
  .copy :global(.cluster) { align-items: flex-start; }
  .copy :global(.dl .note) { display: none; }

  .status { background: color-mix(in srgb, var(--surface) 82%, transparent); border-top: 1px solid var(--line-strong); }
  .status-in { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); padding-block: var(--space-3); }
  .status p { max-width: 74ch; font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.6; letter-spacing: 0.01em; color: var(--text); }
  .status .k { color: var(--warn); }
  .status .link { margin-left: auto; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-stage { height: 100svh; min-height: 38rem; }
    .copy { opacity: clamp(0, calc(1 - (var(--p) - 0.12) * 3.2), 1); transform: translate3d(0, calc(var(--p) * -6vh), 0); }
    .top { opacity: clamp(0, calc(1 - var(--p) * 6), 1); }
    .glow { opacity: calc(0.7 + var(--p) * 0.6); transform: scale(calc(1 + var(--p) * 0.4)); }
    .hero-frame { transform: scale(calc(1 + var(--p) * 0.12)) translate3d(0, calc(var(--p) * -2vh), 0); transform-origin: 50% 50%; will-change: transform; }
    .hero-track[data-stage='1'] .copy { visibility: hidden; }
  }
  @media (min-width: 60rem) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); align-items: center; gap: var(--space-7); padding-top: 6rem; }
    .hero-frame { order: 0; width: 100%; }
    .hero-frame :global(.pframe-cap) { display: block; }
    .copy :global(.dl .note) { display: block; }
    .copy :global(.h1) { font-size: clamp(3rem, 0.5rem + 4.9vw, 6.25rem); }
    .door { right: -6vw; width: min(62vmin, 46rem); opacity: 0.3; }
    @media (prefers-reduced-motion: no-preference) {
      .hero-frame { transform: translate3d(calc(var(--p) * -17vw), calc(var(--p) * -1vh), 0) scale(calc(1 + var(--p) * 0.3)); }
    }
  }
  @media (max-height: 44rem) and (min-width: 60rem) {
    .copy { gap: var(--space-3); }
  }
</style>
