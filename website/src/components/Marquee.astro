---
// Looping ticker. CSS only. Pauses on hover/focus; static (wrapping, no clone) under reduced motion.
// The second list is a visual clone: aria-hidden + inert so it is neither read nor tabbable.
interface Item { name: string; href?: string }
interface Props { items: Item[]; label: string }
const { items, label } = Astro.props;
---

<div class="marquee" role="region" aria-label={label}>
  <div class="lane">
    <ul role="list">
      {items.map((i) => <li>{i.href ? <a href={i.href} data-cursor="Read">{i.name}</a> : <span>{i.name}</span>}</li>)}
    </ul>
    <ul role="list" aria-hidden="true" inert class="clone">
      {items.map((i) => <li><span>{i.name}</span></li>)}
    </ul>
  </div>
</div>

<style>
  .marquee { overflow: hidden; border-block: 1px solid var(--line-strong); -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .lane { display: flex; width: max-content; }
  ul { display: flex; flex-shrink: 0; padding: 0; }
  li { display: flex; align-items: center; }
  li::after { content: ''; width: 0.55rem; height: 0.55rem; margin-inline: clamp(1.25rem, 3vw, 2.75rem); background: var(--accent); transform: rotate(45deg); flex: none; }
  a, span { font-family: var(--font-display); font-size: clamp(2.75rem, 1rem + 6vw, 6.5rem); line-height: 1.3; letter-spacing: -0.02em; white-space: nowrap; color: var(--text); text-decoration: none; background: none; padding: 0; }
  a { transition: color 0.3s, -webkit-text-stroke-color 0.3s; }
  a:hover, a:focus-visible { color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .lane { animation: roll 42s linear infinite; }
    .marquee:hover .lane, .marquee:focus-within .lane { animation-play-state: paused; }
  }
  @keyframes roll { to { transform: translate3d(-50%, 0, 0); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee { -webkit-mask-image: none; mask-image: none; }
    .lane { width: auto; }
    .clone { display: none; }
    ul { flex-wrap: wrap; row-gap: var(--space-2); }
    a, span { font-size: var(--step-4); }
  }
</style>
